<Project>
  <!--
    Directory.Packages.props
    Central Package Management (CPM) for NuGet packages.
    All package versions are defined here to ensure consistency across all projects.

    For more information, see:
    https://learn.microsoft.com/en-us/nuget/consume-packages/central-package-management
  -->
  <PropertyGroup>
    <!-- Enable Central Package Management -->
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Enable transitive pinning for consistent dependency versions -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <!--
    Production Dependencies
    These packages are used by the main library
  -->
  <ItemGroup Label="Production Dependencies">
    <PackageVersion Include="Dapper" Version="2.1.89" />
    <PackageVersion Include="Hangfire.Core" Version="1.8.25" />
    <PackageVersion Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageVersion Include="Oracle.ManagedDataAccess.Core" Version="23.26.301" />
    <!-- Transitive via Oracle.ManagedDataAccess.Core; 8.0.1 is affected by CVE-2026-84008 and CVE-2026-70162. -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="8.0.2" />
    <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="10.0.401" />
  </ItemGroup>
  <!-- 
    Test Dependencies
    These packages are used by test projects only
  -->
  <ItemGroup Label="Test Dependencies">
    <PackageVersion Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.11.2" />
    <PackageVersion Include="xunit.v3" Version="4.0.1" />
  </ItemGroup>
  <!--
    Build/Analyzer Dependencies
    These are automatically included in all projects
  -->
  <ItemGroup Label="Global Analyzers">
    <GlobalPackageReference Include="Microsoft.CodeAnalysis.NetAnalyzers" Version="10.0.403" />
  </ItemGroup>
</Project>
